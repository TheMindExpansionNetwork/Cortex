# Copy to .env next to the compose file you use. Every line is optional.
# CORTEX_IMAGE=ghcr.io/niko1221/cortex:0.2.0-cuda13     # TODO(owner): where the images will be published
# MODEL=IQ3_XXS
# MODEL_PATH=/models                        # with a volume line  - /srv/gguf/IQ3_XXS:/models:ro
# CONTEXT=32k
# PARALLEL=2
# VISION=off
# TUNE=skip
# API_KEY=put-a-long-random-key-here        # openssl rand -hex 24
# CORTEX_BIND=127.0.0.1                     # 0.0.0.0 = reachable from your network (then use a real API_KEY)
# CORTEX_PORT=8080
# RENDER_GID=                               # AMD / Intel only: getent group render | cut -d: -f3
