# Cortex · hosting/Dockerfile.cortex
# The serving image for DeepSeek-V4.1-Flash-1017 (Unsloth GGUF) on llama-server. Build from the repo root:
#
#     docker build -f hosting/Dockerfile.cortex -t cortex .
#     docker run --rm --gpus all -p 8080:8080 -e HF_TOKEN=hf_xxx -v /data:/workspace cortex --quant IQ1_M
#
# CI builds and pushes it: .github/workflows/cortex-docker-image.yml → ghcr.io/themindexpansionnetwork/cortex
#
# RUNTIME CHOICE (important): llama.cpp is built from the official DeepSeek-V4.1 PR (ggml-org/llama.cpp#30817,
# pinned full commit) by scripts/build-llama-dsv41.sh — the SAME script the pod rig uses, so there is one recipe.
# Mainline llama.cpp has no `deepseek41` architecture and would refuse the model after the 250 GB download.
# CUDA archs: sm_80 (A100), sm_89 (L40S/4090), sm_90 (H100/H200), sm_120 (RTX PRO 6000 Blackwell / 5090).
#
# On a GPU-less builder, a CUDA llama-server may not start (`--help` needs libcuda.so.1 from the driver), so the
# build script's flag check is allowed to fail here as long as the binary was produced; the launch script repeats
# the flag check on the GPU box before downloading anything.

FROM nvidia/cuda:12.8.1-devel-ubuntu22.04 AS builder
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates curl git g++ gcc ninja-build python3 python3-pip \
    && rm -rf /var/lib/apt/lists/* \
    && pip3 install --no-cache-dir "cmake>=3.28"
COPY scripts/build-llama-dsv41.sh /build/build-llama-dsv41.sh
WORKDIR /build
RUN SRC=/build/llama.cpp OUT=/build/bin CUDA=ON CUDA_ARCHS="80;89;90;120" bash /build/build-llama-dsv41.sh \
    || test -x /build/bin/llama-server

# ---------------------------------------------------------------------------
FROM nvidia/cuda:12.8.1-runtime-ubuntu22.04
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates curl bash libgomp1 python3 python3-pip \
    && rm -rf /var/lib/apt/lists/* \
    && pip3 install --no-cache-dir -U "huggingface_hub[cli]" hf_transfer

COPY --from=builder /build/bin/llama-server /build/bin/llama-cli /usr/local/bin/
COPY scripts/deepseek-2xa100.sh /opt/cortex/scripts/deepseek-2xa100.sh
RUN chmod 755 /opt/cortex/scripts/deepseek-2xa100.sh

# HF_TOKEN is passed at run time (docker -e / RunPod env / Modal secret); nothing secret is baked in.
ENV HF_HUB_ENABLE_HF_TRANSFER=1
WORKDIR /workspace
EXPOSE 8080

# Downloads the shards into /workspace/models/dsv41 (mount a big volume at /workspace), then execs llama-server.
ENTRYPOINT ["/bin/bash", "/opt/cortex/scripts/deepseek-2xa100.sh"]
CMD ["--quant", "IQ1_M", "--port", "8080"]
